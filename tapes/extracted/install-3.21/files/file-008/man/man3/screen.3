.SH NAME
getkey, gonormal, goraw, wbackspace, wbackword, wcolon, wforspace, wforword, wgetword, whelp, whighlight, wleft, wmesg, wmvcursor, wpageback, wpagefor, wresscrn, wright, wsavescrn, wscrolb, wscrolf \- Screen Interface Library
.SH SYNOPSIS
.nf
\fB#include <curses.h>\fR
\fB#include <screen.h>\fR
.sp
\fBgetkey\fI()\fR
.sp
