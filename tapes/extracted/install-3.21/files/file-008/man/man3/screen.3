.sp
\fBgoraw\fI()\fR
.sp
\fBwbackspace\fI(win, top, bottom)\fR
\fB     WINDOW \fI*win;\fR
\fB     int\fI top, bottom;\fR
\fRor\fR
\fBbackspace\fI(top, bottom)\fR
\fB     int\fI top, bottom;\fR
.sp
\fBwbackword\fI(win, top, bottom)\fR
\fB     WINDOW \fI*win;\fR
\fB     int\fI top, bottom;\fR
\fRor\fR
\fBbackword\fI(top, bottom)\fR
\fB     int\fI top, bottom;\fR
.sp
\fBwcolon\fI(win)\fR
\fB     WINDOW \fI*win;\fR
\fRor\fR
\fBcolon\fI()\fR
.sp
\fBwforspace\fI(win, top, bottom)\fR
\fB     WINDOW \fI*win;\fR
\fB     int\fI top, bottom;\fR
\fRor\fR
\fBforspace\fI(top, bottom)\fR
\fB     int\fI top, bottom;\fR
.sp
\fBwforword\fI(win, top, bottom)\fR
\fB     WINDOW \fI*win;\fR
\fB     int\fI top, bottom;\fR
\fRor\fR
\fBforword\fI(top, bottom)\fR
\fB     int\fI top, bottom;\fR
.sp
\fBwgetword\fI(win, str)\fR
\fB     WINDOW \fI*win;\fR
\fB     char \fI*str;\fR
\fRor\fR
