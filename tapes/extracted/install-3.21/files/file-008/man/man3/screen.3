\fB     char \fI*str;\fR
.sp
\fBwhelp\fI(win, file)\fR
\fB     WINDOW \fI*win;\fR
\fB     char \fI*file;\fR
\fRor\fR
\fBhelp\fI(file)\fR
\fB     char \fI*file;\fR
.sp
\fBwhighlight\fI(win, flag)\fR
\fB     WINDOW \fI*win;\fR
\fB     int\fI flag;\fR
\fRor\fR
\fBhighlight\fI(flag)\fR
\fB     int\fI flag;\fR
.sp
\fBwleft\fI(win, top, bottom)\fR
\fB     WINDOW \fI*win;\fR
\fB     int\fI top, bottom;\fR
\fRor\fR
\fBleft\fI(top, bottom)\fR
