.SH NAME
hypot, cabs \- euclidean distance
.SH SYNOPSIS
.nf
\fB#include <math.h>
.PP
\fBdouble hypot\fI(x, y)\fR
\fB     double\fI x, y;\fR
.PP
\fBdouble cabs\fI(z)\fR
\fB     struct \fI{\fB double\fI x, y;} z;\fR
.fi
.SH DESCRIPTION
.B Hypot
and
.B cabs
return
.PP
.IP "" 15n
sqrt(x*x + y*y),
.LP
taking precautions against unwarranted overflows.
.SH SEE ALSO
exp(3).
