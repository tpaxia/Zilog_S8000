.po 1i
.TH BREAKSW 1C UCB
.V 08/15/84 16:38:43
.\"@[$]breaksw.1C	1.3	08/15/84 16:38:43 - Zilog Inc.
.ad
.SH NAME
breaksw \- C-Shell flow control interrupt statement
.SH SYNOPSIS
.B breaksw
.SH DESCRIPTION
.B  Breaksw
causes a break from a
.B switch,
resuming after the
.B endsw.
The command 
.B breaksw
causes execution to continue after the
.B endsw.
.SH EXAMPLE
.nf
# test
foreach i ( * )
	switch ( $i )
		case ????
			echo "$i is a 4 character filename"
		breaksw

		case ?????
			echo "$i is a 5 character filename"
		breaksw

		case ??????
			echo "$i is a 6 character filename"
		breaksw

		default
			echo "$i is not 4, 5, or 6, characters"
	endswitch
end
.fi
.SH SEE ALSO
foreach(1C), switch(1C), case(1C), echo(1C), default(1C),
endswitch(1C), and end(1C).
.br
\fIThe C Shell\fR in the ZEUS Utilities Manual
