: "One-shot native ZEUS filesystem construction"

exec < /dev/console > /dev/console 2>&1

TZ=PST8PDT
export TZ

echo
echo "Building the Model 31 auxiliary filesystems with native ZEUS mkfs."
echo "Do not reset or quit until NATIVE FILESYSTEM BUILD COMPLETE appears."
echo

/bin/csh /etc/native_layout.csh
exit $?
